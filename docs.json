{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Zepeed Docs",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "navigation": {
    "versions": [
      {
        "version": "1.x",
        "default": true,
        "pages": [
          "1.x/index",
          "1.x/features",
          "1.x/changelog",
          "1.x/troubleshooting",
          "contribute",
          {
            "group": "Getting Started",
            "icon": "notebook",
            "pages": [
              "1.x/quickstart",
              {
                "group": "Installation",
                "pages": [
                  "using-docker-compose",
                  "using-docker-image"
                ]
              },
              "Providers-and-schedule",
              "environment"
            ]
          },
          {
            "group": "Configuration",
            "icon": "brain-cog",
            "pages": [
              "configuration/webhooks",
              "configuration/email-notifications",
              "configuration/maintenance-windows",
              "configuration/ping-monitoring",
              "configuration/dashboard",
              "configuration/user-management"
            ]
          },
          {
            "group": "Integrations",
            "icon": "container",
            "pages": [
              "integrations/prometheus",
              "integrations/mcp",
              "integrations/mcp-parity"
            ]
          },
          "api-reference",
          "local-development",
          {
            "group": "More",
            "icon": "link",
            "pages": [
              "source-code",
              "update-the-docs"
            ]
          }
        ]
      },
      {
        "version": "2.x"
      }
    ]
  },
  "navbar": {
    "links": []
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/MarJose123/Zepeed",
      "linkedin": "https://www.linkedin.com/in/josie-darang"
    }
  },
  "description": "Zepeed is a self-hosted internet speed tracker for monitoring ISP performance.",
  "icons": {
    "library": "lucide"
  },
  "markdown": {
    "schema": false
  },
  "seo": {
    "indexing": "all"
  }
}
