{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Zepeed Docs",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "navigation": {
    "versions": [
      {
        "version": "1.x",
        "default": true,
        "pages": [
          "1.x/index",
          "1.x/features",
          "1.x/changelog",
          "1.x/troubleshooting",
          "contribute",
          {
            "group": "Getting Started",
            "icon": "notebook",
            "pages": [
              "1.x/quickstart",
              {
                "group": "Installation",
                "pages": [
                  "1.x/using-docker-compose",
                  "1.x/using-docker-image"
                ]
              },
              "1.x/Providers-and-schedule",
              "1.x/environment"
            ]
          },
          {
            "group": "Configuration",
            "icon": "brain-cog",
            "pages": [
              "1.x/configuration/webhooks",
              "1.x/configuration/email-notifications",
              "1.x/configuration/maintenance-windows",
              "1.x/configuration/ping-monitoring",
              "1.x/configuration/dashboard",
              "1.x/configuration/user-management"
            ]
          },
          {
            "group": "Integrations",
            "icon": "container",
            "pages": [
              "1.x/integrations/prometheus",
              "1.x/integrations/mcp",
              "1.x/integrations/mcp-parity"
            ]
          },
          "1.x/api-reference",
          "1.x/local-development",
          {
            "group": "More",
            "icon": "link",
            "pages": [
              "source-code",
              "update-the-docs"
            ]
          }
        ]
      },
      {
        "version": "2.x",
        "pages": [
          "2.x/index",
          "2.x/features",
          "2.x/changelog",
          "2.x/upgrading-from-1x",
          "2.x/troubleshooting",
          "2.x/contribute",
          {
            "group": "Getting Started",
            "icon": "notebook",
            "pages": [
              "2.x/quickstart",
              {
                "group": "Installation",
                "pages": [
                  "2.x/using-docker-compose",
                  "2.x/using-docker-image"
                ]
              },
              "2.x/Providers-and-schedule",
              "2.x/environment"
            ]
          },
          {
            "group": "Configuration",
            "icon": "brain-cog",
            "pages": [
              "2.x/configuration/webhooks",
              "2.x/configuration/email-notifications",
              "2.x/configuration/maintenance-windows",
              "2.x/configuration/ping-monitoring",
              "2.x/configuration/dashboard",
              "2.x/configuration/user-management"
            ]
          },
          {
            "group": "Integrations",
            "icon": "container",
            "pages": [
              "2.x/integrations/prometheus",
              "2.x/integrations/mcp",
              "2.x/integrations/mcp-parity"
            ]
          },
          {
            "group": "API Reference",
            "openapi": "openapi.json"
          },
          "2.x/local-development",
          {
            "group": "More",
            "icon": "link",
            "pages": [
              "2.x/source-code",
              "2.x/update-the-docs"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": []
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/MarJose123/Zepeed",
      "linkedin": "https://www.linkedin.com/in/josie-darang"
    }
  },
  "description": "Zepeed is a self-hosted internet speed tracker for monitoring ISP performance.",
  "icons": {
    "library": "lucide"
  },
  "markdown": {
    "schema": false
  },
  "seo": {
    "indexing": "all"
  },
  "integrations": {
    "telemetry": {
      "enabled": true
    }
  },
  "api": {
    "playground": {
      "proxy": true,
      "display": "interactive",
      "credentials": true
    },
    "openapi": "openapi.json",
    "examples": {
      "defaults": "all",
      "prefill": true,
      "autogenerate": true
    },
    "params": {
      "expanded": "all"
    },
    "mdx": {
      "auth": {
        "name": "Bearer"
      },
      "server": "https://api.example.com"
    }
  }
}
